# TrashFire Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/trashfire

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# RunPod Serverless
# Get API key from: https://www.runpod.io/console/user/settings
# Create endpoints manually via RunPod dashboard (queue-based serverless)
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_SDXL_ENDPOINT_ID=your_endpoint_id_here
RUNPOD_WAN_MOTION_ENDPOINT_ID=your_wan_motion_endpoint_id_here

# Storage Provider (r2 or supabase)
STORAGE_PROVIDER=r2
STORAGE_BUCKET=trashfire-keyframes
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=your_storage_access_key_here
STORAGE_SECRET_KEY=your_storage_secret_key_here
STORAGE_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com

# Cloudflare R2 Storage (legacy, for backward compatibility)
# Get credentials from: https://dash.cloudflare.com/
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=trashfire-keyframes
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com

# Clerk Authentication (optional for now)
CLERK_SECRET_KEY=your_clerk_secret_key_here

