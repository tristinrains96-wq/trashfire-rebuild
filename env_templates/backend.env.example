# TrashFire Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/trashfire

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# RunPod Serverless
# Get API key from: https://www.runpod.io/console/user/settings
# Create endpoint manually via RunPod dashboard (queue-based serverless)
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_SDXL_ENDPOINT_ID=your_endpoint_id_here

# Cloudflare R2 Storage
# Get credentials from: https://dash.cloudflare.com/
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=trashfire-keyframes
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com

# Clerk Authentication (optional for now)
CLERK_SECRET_KEY=your_clerk_secret_key_here

